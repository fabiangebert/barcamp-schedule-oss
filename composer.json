{
    "name": "barcamp/schedule",
    "description": "Barcamp Schedule Application",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5.0 || >=8.5.12 <9",
        "ext-zip": "*",
        "slim/slim": "^4.15",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "slim/psr7": "^1.8",
        "firebase/php-jwt": "^7.0",
        "doctrine/dbal": "^4.4",
        "symfony/mailer": "^7.4",
        "doctrine/migrations": "^3.9",
        "ext-curl": "^8.3",
        "ext-gd": "^8.3",
        "async-aws/s3": "^2.0",
        "guzzlehttp/guzzle": "^7.0",
        "opis/json-schema": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "lint:style": "phpcs src public/api tests migrations --standard=PSR12",
        "lint:logic": "phpstan analyse --memory-limit 512M",
        "lint": [
            "@lint:style",
            "@lint:logic"
        ],
        "lint:fix": "phpcbf src public/api tests migrations --standard=PSR12",
        "test": "vendor/bin/phpunit tests",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit tests --coverage-text",
        "test:e2e": "cd frontend && npm run test:e2e",
        "generate:schema": "cd frontend && npm run generate:schema"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
