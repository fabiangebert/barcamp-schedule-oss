{
  "name": "barcamp-schedule-frontend",
  "version": "1.0.0",
  "description": "Vue 3 frontend of the Barcamp Schedule application",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:schema && npm run lint && vite build",
    "test": "vitest run",
    "test:e2e": "node run-e2e.js",
    "test:e2e:ui": "node run-e2e.js --ui",
    "generate:schema": "ts-json-schema-generator --path 'src/types/schedule.ts' --type 'ScheduleData' --expose all > ../backend/resources/schedule.schema.json",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.0",
    "vue-i18n": "^11.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/ui": "^4.1.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.9",
    "prettier": "^3.8.2",
    "rollup": "^4.60.1",
    "tailwindcss": "^4.2.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.2",
    "vue-eslint-parser": "^10.4.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
